    @template mod_gear/quiz

    Example context (json):
    {
        "id": 1,
        "multi": false,
        "text": false,
        "options": [
            {"index": 0, "text": "Option 1"},
            {"index": 1, "text": "Option 2"}
        ]
    }
}}
<div class="gear-quiz-container">
    <form id="gear-quiz-form-{{id}}">
        {{#mesh}}
        <p class="small text-muted mb-2">{{#str}}quiz_mesh_hint, mod_gear{{/str}}</p>
        <div class="mb-2">
            <button type="button" class="btn btn-outline-info btn-sm gear-quiz-mesh-pick">
                <i class="fa fa-crosshairs" aria-hidden="true"></i> {{#str}}quiz_pickmesh, mod_gear{{/str}}
            </button>
            <span class="badge badge-secondary ml-2 gear-quiz-mesh-badge d-none"></span>
            <input type="hidden" class="gear-quiz-mesh-answer" value="">
        </div>
        {{/mesh}}
        {{#pin}}
        <p class="small text-muted mb-2">{{#str}}quiz_pin_hint, mod_gear{{/str}}</p>
        <div class="mb-2">
            <button type="button" class="btn btn-outline-info btn-sm gear-quiz-pin-pick">
                <i class="fa fa-map-pin" aria-hidden="true"></i> {{#str}}quiz_pickpin, mod_gear{{/str}}
            </button>
            <span class="badge badge-secondary ml-2 gear-quiz-pin-badge d-none"></span>
            <input type="hidden" class="gear-quiz-pin-answer" value="">
        </div>
        {{/pin}}
        {{#sequence}}
        <p class="small text-muted mb-2">
            {{#assembly}}{{#str}}quiz_assembly_hint, mod_gear{{/str}}{{/assembly}}
            {{^assembly}}{{#str}}quiz_sequence_hint, mod_gear{{/str}}{{/assembly}}
        </p>
        <div class="mb-2 d-flex flex-wrap align-items-center gap-1">
            <button type="button" class="btn btn-outline-info btn-sm gear-quiz-seq-pick mr-1">
                <i class="fa fa-cubes" aria-hidden="true"></i> {{#str}}quiz_pickseq, mod_gear{{/str}}
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm gear-quiz-seq-clear">
                <i class="fa fa-undo" aria-hidden="true"></i> {{#str}}study_reset, mod_gear{{/str}}
            </button>
        </div>
        <div class="small mb-2 gear-quiz-seq-list text-muted"></div>
        <input type="hidden" class="gear-quiz-seq-answer" value="">
        {{/sequence}}
        {{^mesh}}
        {{^pin}}
        {{^sequence}}
        {{#text}}
        <label class="sr-only visually-hidden" for="gear-quiz-text-{{id}}">{{#str}}quiz_youranswer, mod_gear{{/str}}</label>
        <input type="text" class="form-control gear-quiz-text" id="gear-quiz-text-{{id}}" maxlength="255" autocomplete="off"
            placeholder="{{#str}}quiz_youranswer, mod_gear{{/str}}">
        {{/text}}
        {{^text}}
        {{#multi}}<p class="small text-muted mb-1">{{#str}}quiz_selectall, mod_gear{{/str}}</p>{{/multi}}
        {{#options}}
        <div class="form-check">
            <input class="form-check-input" type="{{#multi}}checkbox{{/multi}}{{^multi}}radio{{/multi}}" name="gear-quiz-option" id="q-opt-{{id}}-{{index}}" value="{{index}}">
            <label class="form-check-label" for="q-opt-{{id}}-{{index}}">{{text}}</label>
        </div>
        {{/options}}
        {{/text}}
        {{/sequence}}
        {{/pin}}
        {{/mesh}}
        
        <button type="button" class="btn btn-primary btn-sm mt-2 gear-quiz-submit">{{#str}}submit, core{{/str}}</button>
        <div class="gear-quiz-feedback mt-2"></div>
    </form>
</div>
