    @template mod_gear/tools_panels

    Floating 3D scene tool panels (Cross-section, Exploded view, Parts & X-Ray, Studio lighting, Presentation bar).

    Example context (json):
    {
        "cmid": 123
    }
}}
<div class="gear-tools-panel gear-clipping-panel d-none" id="gear-clipping-panel-{{cmid}}" role="region" aria-label="{{#str}}clipping_plane, mod_gear{{/str}}">
    <div class="gear-tools-panel-header d-flex justify-content-between align-items-center mb-2">
        <strong><i class="fa fa-cube mr-1" aria-hidden="true"></i> {{#str}}clipping_plane, mod_gear{{/str}}</strong>
        <button type="button" class="close text-white gear-panel-close gear-tools-close" aria-label="{{#str}}close, core{{/str}}">&times;</button>
    </div>
    <div class="gear-tools-panel-body">
        <div class="custom-control custom-switch mb-2">
            <input type="checkbox" class="custom-control-input" id="gear-clip-enable-{{cmid}}">
            <label class="custom-control-label" for="gear-clip-enable-{{cmid}}">{{#str}}clipping_enable, mod_gear{{/str}}</label>
        </div>
        <div class="form-group mb-2">
            <label for="gear-clip-axis-{{cmid}}" class="small mb-1">{{#str}}clipping_axis, mod_gear{{/str}}</label>
            <select class="form-control form-control-sm" id="gear-clip-axis-{{cmid}}">
                <option value="x">X</option>
                <option value="y">Y</option>
                <option value="z">Z</option>
            </select>
        </div>
        <div class="form-group mb-2">
            <label for="gear-clip-offset-{{cmid}}" class="small mb-1">{{#str}}clipping_offset, mod_gear{{/str}}</label>
            <input type="range" class="custom-range w-100" id="gear-clip-offset-{{cmid}}" min="0" max="100" step="1" value="50">
        </div>
        <div class="custom-control custom-checkbox">
            <input type="checkbox" class="custom-control-input" id="gear-clip-flip-{{cmid}}">
            <label class="custom-control-label small" for="gear-clip-flip-{{cmid}}">{{#str}}clipping_flip, mod_gear{{/str}}</label>
        </div>
    </div>
</div>

<div class="gear-tools-panel gear-explode-panel d-none" id="gear-explode-panel-{{cmid}}" role="region" aria-label="{{#str}}explode_view, mod_gear{{/str}}">
    <div class="gear-tools-panel-header d-flex justify-content-between align-items-center mb-2">
        <strong><i class="fa fa-cubes mr-1" aria-hidden="true"></i> {{#str}}explode_view, mod_gear{{/str}}</strong>
        <button type="button" class="close text-white gear-panel-close gear-tools-close" aria-label="{{#str}}close, core{{/str}}">&times;</button>
    </div>
    <div class="gear-tools-panel-body">
        <div class="form-group mb-2">
            <div class="d-flex justify-content-between small mb-1">
                <label for="gear-explode-slider-{{cmid}}" class="mb-0">{{#str}}explode_factor, mod_gear{{/str}}</label>
                <span id="gear-explode-val-{{cmid}}">0%</span>
            </div>
            <input type="range" class="custom-range w-100" id="gear-explode-slider-{{cmid}}" min="0" max="100" step="1" value="0">
        </div>
        <button type="button" class="btn btn-sm btn-outline-light w-100" id="gear-explode-reset-{{cmid}}">{{#str}}explode_reset, mod_gear{{/str}}</button>
    </div>
</div>

<div class="gear-tools-panel gear-parts-panel d-none" id="gear-parts-panel-{{cmid}}" role="region" aria-label="{{#str}}parts_inspector, mod_gear{{/str}}">
    <div class="gear-tools-panel-header d-flex justify-content-between align-items-center mb-2">
        <strong><i class="fa fa-layer-group mr-1" aria-hidden="true"></i> {{#str}}parts_inspector, mod_gear{{/str}}</strong>
        <button type="button" class="close text-white gear-panel-close gear-tools-close" aria-label="{{#str}}close, core{{/str}}">&times;</button>
    </div>
    <div class="gear-tools-panel-body">
        <div class="custom-control custom-switch mb-2">
            <input type="checkbox" class="custom-control-input" id="gear-xray-all-{{cmid}}">
            <label class="custom-control-label" for="gear-xray-all-{{cmid}}">{{#str}}xray_all, mod_gear{{/str}}</label>
        </div>
        <div class="gear-part-name-badge small mb-2" id="gear-part-name-{{cmid}}">{{#str}}part_none_selected, mod_gear{{/str}}</div>
        <div class="btn-group btn-group-sm w-100 mb-2" role="group">
            <button type="button" class="btn btn-outline-light" id="gear-part-isolate-{{cmid}}" disabled>{{#str}}part_isolate, mod_gear{{/str}}</button>
            <button type="button" class="btn btn-outline-light" id="gear-part-hide-{{cmid}}" disabled>{{#str}}part_hide, mod_gear{{/str}}</button>
            <button type="button" class="btn btn-outline-light" id="gear-part-xray-{{cmid}}" disabled>{{#str}}part_xray, mod_gear{{/str}}</button>
        </div>
        <button type="button" class="btn btn-sm btn-outline-warning w-100 mb-2" id="gear-parts-reset-{{cmid}}">{{#str}}parts_reset, mod_gear{{/str}}</button>
        <div class="gear-model-stats small text-light border-top pt-2 mt-1" id="gear-model-stats-{{cmid}}"></div>
    </div>
</div>

<div class="gear-tools-panel gear-env-panel d-none" id="gear-env-panel-{{cmid}}" role="region" aria-label="{{#str}}env_lighting, mod_gear{{/str}}">
    <div class="gear-tools-panel-header d-flex justify-content-between align-items-center mb-2">
        <strong><i class="fa fa-sun mr-1" aria-hidden="true"></i> {{#str}}env_lighting, mod_gear{{/str}}</strong>
        <button type="button" class="close text-white gear-panel-close gear-tools-close" aria-label="{{#str}}close, core{{/str}}">&times;</button>
    </div>
    <div class="gear-tools-panel-body">
        <div class="gear-env-grid mb-2">
            <button type="button" class="btn btn-sm btn-primary active gear-env-preset-btn" data-preset="none">{{#str}}env_none, mod_gear{{/str}}</button>
            <button type="button" class="btn btn-sm btn-outline-light gear-env-preset-btn" data-preset="studio">{{#str}}env_studio, mod_gear{{/str}}</button>
            <button type="button" class="btn btn-sm btn-outline-light gear-env-preset-btn" data-preset="workshop">{{#str}}env_workshop, mod_gear{{/str}}</button>
            <button type="button" class="btn btn-sm btn-outline-light gear-env-preset-btn" data-preset="darklab">{{#str}}env_darklab, mod_gear{{/str}}</button>
        </div>
        <div class="form-group mb-0">
            <div class="d-flex justify-content-between small mb-1">
                <label for="gear-env-exposure-{{cmid}}" class="mb-0">{{#str}}env_exposure, mod_gear{{/str}}</label>
                <span id="gear-env-exposure-val-{{cmid}}">1.00</span>
            </div>
            <input type="range" class="custom-range w-100" id="gear-env-exposure-{{cmid}}" min="0.4" max="2.2" step="0.05" value="1.0">
        </div>
    </div>
</div>

<div class="gear-presentation-bar d-none" id="gear-presentation-bar-{{cmid}}">
    <button type="button" class="btn btn-sm btn-dark gear-present-turntable" title="{{#str}}autorotate, mod_gear{{/str}}">
        <i class="fa fa-sync" aria-hidden="true"></i> {{#str}}autorotate, mod_gear{{/str}}
    </button>
    <button type="button" class="btn btn-sm btn-light gear-present-exit">
        <i class="fa fa-times" aria-hidden="true"></i> {{#str}}presentation_exit, mod_gear{{/str}}
    </button>
</div>

<div class="gear-tools-panel gear-heatmap-panel d-none" id="gear-heatmap-panel-{{cmid}}" role="region" aria-label="{{#str}}heatmap_mode, mod_gear{{/str}}">
    <div class="gear-tools-panel-header d-flex justify-content-between align-items-center mb-2">
        <strong><i class="fa fa-fire mr-1" aria-hidden="true"></i> {{#str}}heatmap_mode, mod_gear{{/str}}</strong>
        <button type="button" class="close text-white gear-panel-close gear-tools-close" aria-label="{{#str}}close, core{{/str}}">&times;</button>
    </div>
    <div class="gear-tools-panel-body small">
        <div class="d-flex align-items-center mb-1"><span class="gear-heatmap-dot gear-heat-low mr-2"></span> {{#str}}heatmap_low_error, mod_gear{{/str}}</div>
        <div class="d-flex align-items-center mb-1"><span class="gear-heatmap-dot gear-heat-mid mr-2"></span> {{#str}}heatmap_mid_error, mod_gear{{/str}}</div>
        <div class="d-flex align-items-center mb-2"><span class="gear-heatmap-dot gear-heat-high mr-2"></span> {{#str}}heatmap_high_error, mod_gear{{/str}}</div>
        <div id="gear-heatmap-summary-{{cmid}}" class="text-light"></div>
    </div>
</div>

<div class="gear-study-bar d-none" id="gear-study-bar-{{cmid}}">
    <span class="badge badge-info mr-2" id="gear-study-progress-{{cmid}}">0 / 0</span>
    <span class="small text-white mr-2">{{#str}}study_hint, mod_gear{{/str}}</span>
    <button type="button" class="btn btn-sm btn-outline-light gear-study-reset mr-1">{{#str}}study_reset, mod_gear{{/str}}</button>
    <button type="button" class="btn btn-sm btn-light gear-study-exit">{{#str}}study_exit, mod_gear{{/str}}</button>
</div>

<div class="gear-split-bar d-none" id="gear-split-bar-{{cmid}}">
    <span class="small text-white mr-2"><i class="fa fa-columns mr-1" aria-hidden="true"></i> {{#str}}split_view, mod_gear{{/str}}</span>
    <input type="range" class="custom-range gear-split-slider mr-2" id="gear-split-slider-{{cmid}}" min="10" max="90" step="1" value="50" aria-label="{{#str}}split_view, mod_gear{{/str}}">
    <button type="button" class="btn btn-sm btn-light gear-split-exit">{{#str}}close, core{{/str}}</button>
</div>
<div class="gear-split-divider d-none" id="gear-split-divider-{{cmid}}"></div>
